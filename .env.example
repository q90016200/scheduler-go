GIN_MODE=debug
APP_ENV=development
SERVER_PORT=8080
SERVER_DOMAIN=localhost
# 開發模式下允許的前端來源（逗號分隔），正式環境同源部署不需要
CORS_ALLOW_ORIGINS=http://localhost:5173
# 任務執行紀錄保留天數，超過會被每日排程清除
EXECUTION_LOG_RETENTION_DAYS=120
APP_SECRET=change-me-to-a-random-secret
TOKEN_EXPIRY=604800

# postgres 配置
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=schedule_go
