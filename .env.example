APP_ENV=development
SERVER_PORT=8080
SERVER_DOMAIN=localhost
# 應用時區：cron 排程、資料庫連線、日誌時間都以此為準（預設 Asia/Taipei）
# 單一任務可在排程前加 CRON_TZ= 覆寫，如 "CRON_TZ=Asia/Tokyo 0 9 * * *"
TIMEZONE=Asia/Taipei
# 日誌等級，未設定時 development 預設 debug、其餘預設 info
LOG_LEVEL=debug
# 任務執行紀錄保留天數，超過會被每日排程清除（預設 120）
EXECUTION_LOG_RETENTION_DAYS=120
APP_SECRET=change-me-to-a-random-secret
# 單位：秒（預設 604800，即 7 天）
TOKEN_EXPIRY=604800
# 是否允許排程任務連線 loopback/link-local 等位址，關閉 SSRF 防護（預設 false）
SSRF_ALLOW_PRIVATE_TARGETS=false

# 失敗通知（任一管道必要欄位留空即視為停用該管道，任務要自行勾選才會實際收到）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# postgres 配置
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=schedule_go
# postgres sslmode（預設 disable）
POSTGRES_SSLMODE=disable
# 連線池設定（預設 25 / 5 / 60）
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME_MINUTES=60
